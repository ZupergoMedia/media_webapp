# ---------------------------------------------------------------------------
# ZuperGo Media — environment template
#
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Postgres + PostGIS.
#
# On Neon: DATABASE_URL is the POOLED connection string, DIRECT_URL is the
# DIRECT/unpooled one. Prisma migrations MUST use the unpooled endpoint —
# they fail against the pooler.
#
# Using local Docker instead (`docker compose up -d`), point both at:
#   postgresql://zupergo:zupergo@localhost:5432/zupergo
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Maps -------------------------------------------------------------------
# Provider: "maplibre" (default) | "maptiler"
#
# "maplibre" needs NO account and NO token. It renders MapLibre GL over free
# OpenStreetMap raster tiles, so the map works out of the box.
#
# If "maptiler" is selected but its key is missing, the app falls back to
# "maplibre" rather than rendering a blank map.
NEXT_PUBLIC_MAP_PROVIDER="maplibre"

# Optional upgrade — vector tiles and better cartography. Free tier 100k loads/mo.
# Create at https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=""

# NOTE ON MAPBOX: not supported through this config. `mapbox://` styles require
# Mapbox's proprietary SDK and a different renderer entry point
# (react-map-gl/mapbox), not just a different style URL. To adopt it, swap the
# import in src/components/map/map-view.tsx — everything else is unaffected.
#
# NOTE ON PRODUCTION: the default OpenStreetMap tile servers are fine for local
# development, but their usage policy prohibits heavy production traffic. Set a
# MapTiler key before launch.

# Auth.js / NextAuth v5. Generate with: openssl rand -base64 32
# Signs session cookies — required. Rotating it signs everyone out.
AUTH_SECRET=""

# Password given to the seeded demo accounts (advertiser/owner/admin).
# Local development only. The seed refuses to set passwords without it, so a
# deployed database never ends up with predictable credentials.
SEED_DEMO_PASSWORD=""

# Salts the IP hash stored on anonymous sale enquiries, so the SaleEnquiry
# table is never a plaintext IP log. Generate with: openssl rand -base64 32
# Only needs to be unguessable in production — real rate limiting is a
# phase-2 item (see the TODO in sale-enquiry-service.ts); this salt just keeps
# today's DB-backed rate-limit checks from doubling as an IP log.
SALE_ENQUIRY_IP_SALT=""

# Canonical origin, used for absolute URLs in metadata and OpenGraph tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Analytics measurement id (from admin.google.com/analytics). Left
# unset in local development on purpose — set it only in the deployed
# environment so dev/preview traffic never pollutes real analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Vercel Blob — stores partner-uploaded listing photos. Provisioned
# automatically by `vercel blob create-store` and pulled into .env.local by
# `vercel env pull`; you should not need to set this by hand. Without it,
# image upload fails and partners can only paste hosted image URLs.
BLOB_READ_WRITE_TOKEN=""

# Service layer wiring. `mock` runs the UI without a database — useful before
# DATABASE_URL is provisioned. `live` uses the real Prisma-backed services.
SERVICE_MODE="live"
